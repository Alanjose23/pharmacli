# copy to .env and edit. An environment variable beats this file.
PHARMACLI_DB=pharmacli.db
PHARMACLI_WORKERS=10
PHARMACLI_TIMEOUT=30
PHARMACLI_LOG_LEVEL=INFO

# state dispensing fee on top of ingredient cost. 10.64 is the Medicaid
# standard. Drives break-even quantity in `margin` and the appeal pack.
PHARMACLI_DISPENSING_FEE=10.64

# the model `pharmacli sweep` promotes; its .json sidecar sits beside it.
# Read by `pharmacli forecast` and by the FastAPI service.
PHARMACLI_MODEL=models/pharmacli-mover.joblib
