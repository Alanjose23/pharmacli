# copy to .env and edit. An environment variable beats this file.
PHARMACLI_DB=pharmacli.db
PHARMACLI_WORKERS=10
PHARMACLI_TIMEOUT=30
PHARMACLI_LOG_LEVEL=INFO

# state dispensing fee on top of ingredient cost. 10.64 is the Medicaid
# standard. Drives break-even quantity in `margin` and the appeal pack.
PHARMACLI_DISPENSING_FEE=10.64

# the model `pharmacli sweep` promotes; its .json sidecar sits beside it.
# Read by `pharmacli forecast` and by the FastAPI service.
PHARMACLI_MODEL=models/pharmacli-mover.joblib

# week 9: RAG. `docker compose up -d chroma ollama` publishes both on localhost.
PHARMACLI_CHROMA_URL=http://127.0.0.1:8001
PHARMACLI_OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5:1.5b-instruct if the 3B model does not fit in memory
PHARMACLI_LLM=qwen2.5:3b-instruct
PHARMACLI_EMBED=all-minilm:l6-v2
# fixed | section
PHARMACLI_CHUNKING=section
PHARMACLI_K=3
PHARMACLI_RELEVANCE_FLOOR=0.35

# week 10: signs the API's bearer tokens. No default: `docker compose up`
# refuses to start without it, and `pharmacli token` must run with the same
# value the API runs with.
#   echo "PHARMACLI_JWT_SECRET=$(openssl rand -hex 32)" >> .env
PHARMACLI_JWT_SECRET=
